;; Переменные звука (оставляем легкий poll, так как wpctl не имеет встроенного демона событий)
(defpoll current_volume :interval "0.2s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2 * 100}'")
(defpoll is_muted :interval "0.2s" "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q 'MUTED' && echo 'true' || echo 'false'")
(defpoll sink_json :interval "2s" "wpctl-helper sinks")

;; ПОЛНАЯ ОПТИМИЗАЦИЯ: Мгновенный перехват изменения трека по событиям D-Bus (0% нагрузки на CPU)
(deflisten track_title "playerctl metadata --follow --format '{{ artist }} - {{ title }}' 2>/dev/null || echo 'No media playing'")

(defwindow bw-volume-applet
  :monitor 0
  :geometry (geometry :x "15px"
                      :y "50px"
                      :width "360px"
                      :height "280px"
                      :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable true
  (volume_layout))

(defwidget volume_layout []
  (box :class "bw-window"
    (box :orientation "v" :space-evenly false :hexpand true :vexpand true
      
      ;; Блок 1: Громкость
      (box :class "bw-section" :orientation "v" :space-evenly false
        (box :orientation "h" :space-evenly false
          (label :text {is_muted == "true" ? "[MUTED]" : "[VOL]"} :class "bw-label-bold" :halign "start")
          (label :text "${current_volume}%" :hexpand true :halign "end" :class "bw-label-bold"))
        (scale :min 0 :max 101 :value current_volume :class "bw-slider"
               :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%"))
      
      (box :class "bw-divider")

      ;; Блок 2: Плеер
      (box :class "bw-section" :orientation "v" :space-evenly false
        (label :text "[NOW PLAYING]" :halign "start" :class "bw-label-dim")
        (label :text track_title :limit-width 35 :halign "start" :class "bw-track-title")
        (box :class "bw-controls" :space-evenly true
          (button :onclick "playerctl previous" "<<")
          (button :onclick "playerctl toggle" "||")
          (button :onclick "playerctl next" ">>")
          (button :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" "[MUTE]")))

      (box :class "bw-divider")

      ;; Блок 3: Источники
      (box :class "bw-section" :orientation "v" :space-evenly false :vexpand true
        (label :text "[OUTPUT SOURCES]" :halign "start" :class "bw-label-dim")
        (scroll :height 100 :vscroll true :hexpand true :vexpand true
          (box :orientation "v" :space-evenly false :class "sink-list" :hexpand true
            (for sink in sink_json
              (button :class {sink.active ? "sink-btn-active" : "sink-btn"}
                      :onclick "wpctl-helper set-sink ${sink.id}"
                (box :orientation "h" :space-evenly false :hexpand true
                  (label :text "${sink.icon} " :class "bw-mono" :halign "start")
                  (label :text "${sink.name}" :limit-width 28 :halign "start"))))))))))

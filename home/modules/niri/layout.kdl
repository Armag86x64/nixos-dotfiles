prefer-no-csd

cursor {
    // Укажите название темы (например, "Bibata-Modern-Classic")
    xcursor-theme "capitaine-cursors"
    // Укажите размер
    xcursor-size 30
}

layout {
    gaps 4

    center-focused-column "never"
    background-color "#000000"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 1.0; }

    focus-ring {
        // off

        width 1 

        active-color "#d1d1d1"

        inactive-color "#595959"
        urgent-color "#9b0000"

    }

    border {
        off

        width 2
        active-color "#d1d1d1"
        inactive-color "#595959"

        urgent-color "#9b0000"

    }


    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}
